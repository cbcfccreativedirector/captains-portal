# ============================================================
# CB Captains FC — Player Portal — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git!
# ============================================================

# --- NEXTAUTH (Authentication) ---
# Generate a secret: run this in terminal → openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl
NEXTAUTH_URL=http://localhost:3000

# --- ADMIN LOGIN ---
# This is the password club officials use to log into the dashboard
ADMIN_PASSWORD=YourSecurePasswordHere123!

# --- GOOGLE SHEETS ---
# Your Google Cloud service account email (looks like: name@project-id.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Your Google Cloud service account private key
# Copy the ENTIRE key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
# Replace newlines with \n when putting in .env.local
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The ID from your Google Spreadsheet URL
# URL looks like: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# The name of the tab/sheet inside your spreadsheet (default: Players)
GOOGLE_SHEET_NAME=Players

# --- RATE LIMITING ---
# Max submissions per IP per hour (prevents spam)
RATE_LIMIT_MAX=5
